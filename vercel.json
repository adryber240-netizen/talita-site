{
  "redirects": [
    {
      "source": "/:file.avif",
      "destination": "/:file.webp",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/:all.(webp|png|avif)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/styles.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
